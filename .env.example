APP_CONFIG=production
FLASK_APP=app

SECRET_KEY=change-me-use-python-secrets-token-hex-32

# Bank sync: Fernet key encrypting bank secrets (REQUIRED in production, keep it safe: losing it loses stored connections)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANK_SECRETS_KEY=change-me-fernet-key

# Public URLs (behind the reverse proxy, HTTPS)
APP_BASE_URL=https://budget.example.com
BANK_REDIRECT_URL=https://budget.example.com/bank/callback

# Public sign-up (« Créer un foyer »). Closed by default in production: only invite links work,
# except for the very first account of an empty database.
ALLOW_REGISTRATION=false

# Scheduler jobs (06:00 sync, 07:00 expiries, 08:00 alerts) follow the container time zone
TZ=Europe/Paris

# MariaDB
DATABASE_URL=mysql+pymysql://tcf:change-me@db:3306/tcf
MARIADB_DATABASE=tcf
MARIADB_USER=tcf
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-root

# Mail — via host docker-mailserver on port 587
MAIL_SERVER=host.docker.internal
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=change-me
MAIL_DEFAULT_SENDER=noreply@example.com
